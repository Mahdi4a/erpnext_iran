{
 "doctype": "DocType",
 "name": "Iran Cheque",
 "module": "Erpnext Iran",
 "engine": "InnoDB",
 "is_submittable": 1,
 "autoname": "format:CHQ-{YYYY}-{####}",
 "title_field": "cheque_no",
 "search_fields": "cheque_no,party,sayad_id",
 "track_changes": 1,
 "field_order": [
  "cheque_type",
  "company",
  "status",
  "column_break_1",
  "cheque_no",
  "sayad_id",
  "amount",
  "currency",
  "section_dates",
  "issue_date",
  "column_break_2",
  "due_date",
  "section_party",
  "party_type",
  "party",
  "column_break_3",
  "bank",
  "bank_account",
  "endorsed_to",
  "section_notes",
  "remarks",
  "postings",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "cheque_type",
   "label": "Type",
   "fieldtype": "Select",
   "options": "Received\nIssued",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Received: چک دریافتنی. Issued: چک پرداختنی"
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "\nIn Hand\nDeposited\nCleared\nBounced\nEndorsed\nIssued\nCancelled",
   "read_only": 1,
   "allow_on_submit": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "no_copy": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cheque_no",
   "label": "Cheque Number (شماره چک)",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sayad_id",
   "label": "Sayad ID (شناسه صیاد)",
   "fieldtype": "Data",
   "description": "16 digits"
  },
  {
   "fieldname": "amount",
   "label": "Amount",
   "fieldtype": "Currency",
   "options": "currency",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "currency",
   "label": "Currency",
   "fieldtype": "Link",
   "options": "Currency",
   "read_only": 1,
   "fetch_from": "company.default_currency"
  },
  {
   "fieldname": "section_dates",
   "fieldtype": "Section Break",
   "label": "Dates"
  },
  {
   "fieldname": "issue_date",
   "label": "Issue Date (تاریخ صدور)",
   "fieldtype": "Date",
   "reqd": 1,
   "default": "Today"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "due_date",
   "label": "Due Date (تاریخ سررسید)",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_party",
   "fieldtype": "Section Break",
   "label": "Party and Bank"
  },
  {
   "fieldname": "party_type",
   "label": "Party Type",
   "fieldtype": "Select",
   "options": "Customer\nSupplier",
   "reqd": 1,
   "description": "Received cheques come from a Customer, issued cheques go to a Supplier"
  },
  {
   "fieldname": "party",
   "label": "Party",
   "fieldtype": "Dynamic Link",
   "options": "party_type",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "bank",
   "label": "Bank",
   "fieldtype": "Link",
   "options": "Bank"
  },
  {
   "fieldname": "bank_account",
   "label": "Bank Account",
   "fieldtype": "Link",
   "options": "Bank Account",
   "description": "Issued: the account the cheque is drawn on. Received: the account it is collected into.",
   "mandatory_depends_on": "eval:doc.cheque_type=='Issued'"
  },
  {
   "fieldname": "endorsed_to",
   "label": "Endorsed To (خرج چک)",
   "fieldtype": "Link",
   "options": "Supplier",
   "read_only": 1,
   "allow_on_submit": 1,
   "depends_on": "eval:doc.endorsed_to"
  },
  {
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Notes and Postings"
  },
  {
   "fieldname": "remarks",
   "label": "Remarks",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "postings",
   "label": "Postings",
   "fieldtype": "Table",
   "options": "Iran Cheque Posting",
   "read_only": 1,
   "allow_on_submit": 1,
   "no_copy": 1
  },
  {
   "fieldname": "amended_from",
   "label": "Amended From",
   "fieldtype": "Link",
   "options": "Iran Cheque",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "permissions": [
  {
   "role": "Accounts Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Accounts User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  }
 ],
 "sort_field": "creation",
 "sort_order": "DESC",
 "states": []
}
