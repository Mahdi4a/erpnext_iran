#: erpnext/stock/doctype/item/item.js:417
msgid "Activate Serial / Batch No for Item"
msgstr "فعال‌سازی شمارهٔ سریال / دسته برای کالا"

#: erpnext/stock/doctype/item/item.js:26
msgid "Also you can't switch back to FIFO after setting the valuation method to Moving Average for this item."
msgstr "همچنین پس از تعیین روش ارزش‌گذاری «میانگین متحرک» برای این کالا، نمی‌توانید به FIFO برگردید."

#: erpnext/stock/doctype/item/item.js:369
msgid "Please select the Warehouse first"
msgstr "لطفاً ابتدا انبار را انتخاب کنید"

#: erpnext/stock/doctype/item/item.js:200
msgid "This Item is a Template and cannot be used in transactions.<br>All fields present in the 'Copy Fields to Variant' table in Item Variant Settings will be copied to its variant items."
msgstr "این کالا قالب است و در تراکنش‌ها قابل استفاده نیست.<br>همهٔ فیلدهای جدول «کپی فیلدها به گونه» در تنظیمات گونهٔ کالا به کالاهای گونه کپی می‌شوند."

#: erpnext/stock/doctype/item/item.js:899
msgid "{0}: remove invalid value(s) {1}"
msgstr "{0}: مقدار(های) نامعتبر {1} را حذف کنید"

#: erpnext/stock/doctype/item/item.js:906
msgid "{0}: select the typed value {1} from the list or clear it"
msgstr "{0}: مقدار تایپ‌شدهٔ {1} را از فهرست انتخاب کنید یا پاک کنید"

#: erpnext/stock/doctype/item/item.json:None
msgid "<div style=\"margin-bottom:10px; color: var(--gray-500) !important;\">Define alternate units for this item. Eg: 1 Box = 12 Nos, set conversion factor as 12. (Will also apply for variants) <a href=\"https://docs.frappe.io/erpnext/uom\" target=\"_blank\">Learn more &#8594;</a></div>"
msgstr "<div style=\"margin-bottom:10px; color: var(--gray-500) !important;\">برای این کالا واحدهای جایگزین تعریف کنید. مثلاً: ۱ جعبه = ۱۲ عدد، ضریب تبدیل را ۱۲ بگذارید. (برای گونه‌ها هم اعمال می‌شود) <a href=\"https://docs.frappe.io/erpnext/uom\" target=\"_blank\">بیشتر بدانید &#8594;</a></div>"

#: erpnext/stock/doctype/item/item.json:None
msgid "A quality inspection must be completed before generating a Delivery Note for this item."
msgstr "پیش از ایجاد یادداشت تحویل برای این کالا باید بازرسی کیفیت انجام شود."

#: erpnext/stock/doctype/item/item.json:None
msgid "A quality inspection must be completed before generating a Purchase Receipt for this item."
msgstr "پیش از ایجاد رسید خرید برای این کالا باید بازرسی کیفیت انجام شود."

#: erpnext/stock/doctype/item/item.json:None
msgid "Allow stock to go below zero for this item, even if negative stock is disabled in Stock Settings."
msgstr "اجازه می‌دهد موجودی این کالا از صفر پایین‌تر برود، حتی اگر موجودی منفی در تنظیمات موجودی غیرفعال باشد."

#: erpnext/stock/doctype/item/item.json:None
msgid "Allow substituting this item with an alternative from the Item Alternative list when stock is unavailable."
msgstr "هنگام ناموجود بودن، جایگزینی این کالا با گزینهٔ جایگزین از فهرست کالاهای جایگزین را مجاز می‌کند."

#: erpnext/stock/doctype/item/item.json:None
msgid "Allow this item to be used in purchase transactions."
msgstr "اجازه می‌دهد این کالا در تراکنش‌های خرید استفاده شود."

#: erpnext/stock/doctype/item/item.json:None
msgid "Allow this item to be used in sales transactions."
msgstr "اجازه می‌دهد این کالا در تراکنش‌های فروش استفاده شود."

#: erpnext/stock/doctype/item/item.json:None
msgid "Batch number will be auto-created in format AAAA.00001 if not specified in transactions. Leave blank to always enter batch numbers manually."
msgstr "اگر شمارهٔ دسته در تراکنش‌ها مشخص نشود، با قالب AAAA.00001 به‌طور خودکار ایجاد می‌شود. برای وارد کردن دستی همیشهٔ شمارهٔ دسته، خالی بگذارید."

#: erpnext/stock/doctype/item/item.json:None
msgid "Batch number will be created based on expiry date. Expiry dates can be set in the Batch master."
msgstr "شمارهٔ دسته بر اساس تاریخ انقضا ایجاد می‌شود. تاریخ‌های انقضا را می‌توان در اطلاعات اصلی دسته تعیین کرد."

#: erpnext/stock/doctype/item/item.json:None
msgid "Creates a single grouped asset instead of individual assets when purchased in bulk."
msgstr "در خرید عمده، به‌جای دارایی‌های جداگانه یک دارایی گروهی واحد ایجاد می‌کند."

#: erpnext/stock/doctype/item/item.json:None
msgid "Creates an Item Price automatically when the item is saved"
msgstr "هنگام ذخیرهٔ کالا، به‌طور خودکار قیمت کالا ایجاد می‌کند"

#: erpnext/stock/doctype/item/item.json:None
msgid "Defines the date after which the item can no longer be used in transactions or manufacturing"
msgstr "تاریخی را تعیین می‌کند که پس از آن کالا دیگر در تراکنش‌ها یا تولید قابل استفاده نیست"

#: erpnext/stock/doctype/item/item.json:None
msgid "ERPNext will make a stock ledger entry for each transaction of this item. Keep unchecked for non-stock or service items."
msgstr "ERPNext برای هر تراکنش این کالا یک ثبت در دفتر موجودی ایجاد می‌کند. برای کالاهای غیرموجودی یا خدماتی علامت نزنید."

#: erpnext/stock/doctype/item/item.json:None
msgid "Enable for drop shipping - supplier delivers directly to the customer without passing through your warehouse."
msgstr "برای ارسال مستقیم فعال کنید - تأمین‌کننده بدون عبور از انبار شما مستقیم به مشتری تحویل می‌دهد."

#: erpnext/stock/doctype/item/item.json:None
msgid "Enable for raw material items used in BOM. Uncheck for additional services like 'washing' used in manufacturing."
msgstr "برای کالاهای مواد خام مورد استفاده در صورتحساب مواد فعال کنید. برای خدمات اضافی مانند «شست‌وشو» که در تولید استفاده می‌شوند علامت نزنید."

#: erpnext/stock/doctype/item/item.json:None
msgid "Enable if a vendor manufactures this item for you. You can choose to provide them raw materials using the default BOM."
msgstr "اگر فروشنده این کالا را برای شما تولید می‌کند فعال کنید. می‌توانید با صورتحساب مواد پیش‌فرض، مواد خام را در اختیار او بگذارید."

#: erpnext/stock/doctype/item/item.json:None
msgid "Enable if this item is a company asset like machinery or furniture."
msgstr "اگر این کالا دارایی شرکت مانند ماشین‌آلات یا مبلمان است فعال کنید."

#: erpnext/stock/doctype/item/item.json:None
msgid "Enable if this item is provided by a customer and received via Stock Entry."
msgstr "اگر این کالا را مشتری ارائه می‌دهد و از طریق ثبت موجودی دریافت می‌شود فعال کنید."

#: erpnext/stock/doctype/item/item.json:None
msgid "Enable to reserve a small sample from each batch for any analysis arising ahead"
msgstr "برای رزرو نمونهٔ کوچکی از هر دسته جهت هرگونه تحلیل بعدی فعال کنید"

#: erpnext/stock/doctype/item/item.json:None
msgid "Example: ABCD.#####
If series is set and Serial No is not mentioned in transactions, then automatic serial number will be created based on this series. If you always want to explicitly mention Serial Nos for this item. leave this blank."
msgstr "مثال: ABCD.#####
اگر سری تعیین شده باشد و شمارهٔ سریال در تراکنش‌ها ذکر نشود، شمارهٔ سریال خودکار بر اساس این سری ایجاد می‌شود. اگر همیشه می‌خواهید شمارهٔ سریال این کالا را صریحاً ذکر کنید، این را خالی بگذارید."

#: erpnext/stock/doctype/item/item.json:None
msgid "Expense for this item will be recognized over a period of months. Eg: prepaid insurance or annual software license"
msgstr "هزینهٔ این کالا طی چند ماه شناسایی می‌شود. مثال: بیمهٔ پیش‌پرداخت یا مجوز سالانهٔ نرم‌افزار"

#: erpnext/stock/doctype/item/item.json:None
msgid "If enabled, sales from this item will be included in Sales Person and Sales Partner commission calculations"
msgstr "در صورت فعال بودن، فروش این کالا در محاسبهٔ کمیسیون شخص فروش و شریک فروش لحاظ می‌شود"

#: erpnext/stock/doctype/item/item.json:None
msgid "Income from this item will be recognized over a period of months instead of all at once. Eg: annual subscription paid upfront."
msgstr "درآمد این کالا به‌جای یک‌جا، طی چند ماه شناسایی می‌شود. مثال: اشتراک سالانهٔ پیش‌پرداخت‌شده."

#: erpnext/stock/doctype/item/item.json:None
msgid "Inventory Valuation"
msgstr "ارزش‌گذاری موجودی"

#: erpnext/stock/doctype/item/item.json:None
msgid "Maximum discount % allowed when selling this item. Eg: if set to 20%, a discount greater than 20% cannot be applied in sales transactions."
msgstr "حداکثر درصد تخفیف مجاز هنگام فروش این کالا. مثال: اگر ۲۰٪ باشد، تخفیف بیش از ۲۰٪ در تراکنش‌های فروش قابل اعمال نیست."

#: erpnext/stock/doctype/item/item.json:None
msgid "Minimum quantity should be as per Stock UOM

"
msgstr "حداقل مقدار باید بر اساس واحد موجودی باشد

"

#: erpnext/stock/doctype/item/item.json:None
msgid "Minimum stock level to maintain as a buffer. Used to calculate recommended reorder level: Reorder Level = Safety Stock + (Average Daily Consumption × Lead Time)."
msgstr "حداقل سطح موجودی برای نگهداری به‌عنوان ذخیره. برای محاسبهٔ سطح سفارش مجدد پیشنهادی استفاده می‌شود: سطح سفارش مجدد = موجودی اطمینان + (میانگین مصرف روزانه × زمان تأمین)."

#: erpnext/stock/doctype/item/item.json:None
msgid "Percentage by which over-billing is allowed against a Sales/Purchase Order for this item. If not set, value from Accounts Settings will be used."
msgstr "درصدی که فاکتور بیش از حد در برابر سفارش فروش/خرید برای این کالا مجاز است. اگر تعیین نشود، مقدار تنظیمات حساب‌ها استفاده می‌شود."

#: erpnext/stock/doctype/item/item.json:None
msgid "Percentage by which over-delivery or over-receipt is allowed against a Sales/Purchase Order for this item. If not set, value from Stock Settings will be used."
msgstr "درصدی که تحویل یا دریافت بیش از حد در برابر سفارش فروش/خرید برای این کالا مجاز است. اگر تعیین نشود، مقدار تنظیمات موجودی استفاده می‌شود."

#: erpnext/stock/doctype/item/item.json:None
msgid "Prices HTML"
msgstr "HTML قیمت‌ها"

#: erpnext/stock/doctype/item/item.json:None
msgid "Serial Nos / Batches"
msgstr "شماره‌های سریال / دسته‌ها"

#: erpnext/stock/doctype/item/item.json:None
msgid "Serialized items are valued at Moving Average once stock transactions exist and Serial No Wise Valuation is disabled."
msgstr "وقتی تراکنش موجودی وجود دارد و ارزش‌گذاری بر اساس شمارهٔ سریال غیرفعال است، کالاهای سریال‌دار با میانگین متحرک ارزش‌گذاری می‌شوند."

#: erpnext/stock/doctype/item/item.json:None
msgid "Stock Levels HTML"
msgstr "HTML سطوح موجودی"

#: erpnext/stock/doctype/item/item.json:None
msgid "The rate at which this item was last purchased via a Purchase Invoice. Auto-updated by the system."
msgstr "نرخی که این کالا آخرین بار از طریق فاکتور خرید خریداری شده است. به‌طور خودکار توسط سیستم به‌روزرسانی می‌شود."

#: erpnext/stock/doctype/item/item.json:None
msgid "Track each unit with a unique serial number for warranty and return tracking. Cannot be changed after a stock transaction exists."
msgstr "هر واحد را با شمارهٔ سریال یکتا برای پیگیری گارانتی و برگشت دنبال کنید. پس از وجود تراکنش موجودی قابل تغییر نیست."

#: erpnext/stock/doctype/item/item.json:None
msgid "Track this item in batches. Cannot be changed after a stock transaction exists."
msgstr "این کالا را به‌صورت دسته‌ای دنبال کنید. پس از وجود تراکنش موجودی قابل تغییر نیست."

#: erpnext/stock/doctype/item/item.json:None
msgid "Use Serial No Wise Valuation"
msgstr "استفاده از ارزش‌گذاری بر اساس شمارهٔ سریال"

#: erpnext/stock/doctype/item/item.json:None
msgid "Used to create an opening Stock Entry with the Valuation Rate when the item is saved"
msgstr "هنگام ذخیرهٔ کالا برای ایجاد ثبت موجودی افتتاحیه با نرخ ارزش‌گذاری استفاده می‌شود"

#: erpnext/stock/doctype/item/item.json:None
msgid "Value every outward movement at each Serial No's own incoming rate. If unchecked, the item is valued at Moving Average once stock transactions exist. Cannot be enabled once Serial Nos exist for this item."
msgstr "هر خروج را با نرخ ورودی خود هر شمارهٔ سریال ارزش‌گذاری کن. اگر علامت نخورد، پس از وجود تراکنش موجودی کالا با میانگین متحرک ارزش‌گذاری می‌شود. وقتی برای این کالا شمارهٔ سریال وجود دارد قابل فعال‌سازی نیست."

#: erpnext/stock/doctype/item/item.py:1196
msgid "Cannot change Item {0} from serialized to non-serialized because a Serial and Batch Bundle exists for it. Please delete or cancel the Serial and Batch Bundle first."
msgstr "نوع کالای {0} را نمی‌توان از سریال‌دار به غیرسریال‌دار تغییر داد، چون برای آن بستهٔ سریال و دسته وجود دارد. ابتدا بستهٔ سریال و دسته را حذف یا لغو کنید."

#: erpnext/stock/doctype/item/item.py:1277
msgid "Cannot enable {0} as {1} is disabled in {2}"
msgstr "{0} قابل فعال‌سازی نیست، چون {1} در {2} غیرفعال است"

#: erpnext/stock/doctype/item/item.py:262
msgid "Image in the description has been removed. To disable this behavior, uncheck \"{0}\" in {1}."
msgstr "تصویر موجود در شرح حذف شد. برای غیرفعال کردن این رفتار، «{0}» را در {1} غیرفعال کنید."

#: erpnext/stock/doctype/item/item.py:605
msgid "Incorrect Check in (group) Warehouse for Reorder"
msgstr "علامت‌گذاری نادرست انبار (گروه) برای سفارش مجدد"

#: erpnext/stock/doctype/item/item.py:1178
msgid "Invalid Valuation Method"
msgstr "روش ارزش‌گذاری نامعتبر"

#: erpnext/stock/doctype/item/item.py:602
msgid "Row #{0}: The warehouse {1} is not a child warehouse of a group warehouse {2}"
msgstr "ردیف #{0}: انبار {1} زیرمجموعهٔ انبار گروهی {2} نیست"

#: erpnext/stock/doctype/item/item.py:1282
msgid "Serial / Batch No Not Activated"
msgstr "شمارهٔ سریال / دسته فعال نشده است"

#: erpnext/stock/doctype/item/item.py:499
msgid "Serial No Series Overlap"
msgstr "همپوشانی سری شمارهٔ سریال"

#: erpnext/stock/doctype/item/item.py:1149
msgid "Serial No Wise Valuation cannot be enabled for Item {0} because Serial Nos already exist for it. Valuation for those Serial Nos was not tracked, so enabling it now would value outward entries incorrectly."
msgstr "ارزش‌گذاری بر اساس شمارهٔ سریال برای کالای {0} قابل فعال‌سازی نیست، چون برای آن شمارهٔ سریال وجود دارد. ارزش‌گذاری آن شماره‌های سریال پیگیری نشده است و فعال کردن آن اکنون باعث ارزش‌گذاری نادرست خروج‌ها می‌شود."

#: erpnext/stock/doctype/item/item.py:1152
msgid "Serial Nos Exist"
msgstr "شماره‌های سریال وجود دارند"

#: erpnext/stock/doctype/item/item.py:1199
msgid "Serial and Batch Bundle Exists"
msgstr "بستهٔ سریال و دسته وجود دارد"

#: erpnext/stock/doctype/item/item.py:496
msgid "The {0} prefix '{1}' already exists. Please change the Serial No Series, otherwise you will get a Duplicate Entry error."
msgstr "پیشوند {0} '{1}' از قبل وجود دارد. لطفاً سری شمارهٔ سریال را تغییر دهید، در غیر این صورت خطای ثبت تکراری می‌گیرید."

#: erpnext/stock/doctype/item/item.py:1175
msgid "Valuation Method for Item {0} must be Moving Average because Serial No Wise Valuation is disabled. Enable Serial No Wise Valuation to use FIFO or LIFO."
msgstr "روش ارزش‌گذاری کالای {0} باید میانگین متحرک باشد، چون ارزش‌گذاری بر اساس شمارهٔ سریال غیرفعال است. برای استفاده از FIFO یا LIFO آن را فعال کنید."

#: erpnext/stock/doctype/item/item_prices.html:128
msgid "+ Add Price"
msgstr "+ افزودن قیمت"

#: erpnext/stock/doctype/item/item_prices.html:72
msgid "All active prices for this item across buying and selling price lists."
msgstr "همهٔ قیمت‌های فعال این کالا در لیست‌های قیمت خرید و فروش."

#: erpnext/stock/doctype/item/item_prices.html:96
msgid "Buy & Sell"
msgstr "خرید و فروش"

#: erpnext/stock/doctype/item/item_prices.html:86
msgid "Valid Upto"
msgstr "معتبر تا"

#: erpnext/stock/doctype/item/item_prices.html:123
msgid "View All Prices"
msgstr "مشاهدهٔ همهٔ قیمت‌ها"

#: erpnext/stock/doctype/batch/batch.js:85
msgid "No stock available for this batch."
msgstr "موجودی‌ای برای این دسته وجود ندارد."

#: erpnext/stock/doctype/batch/batch.js:28
msgid "Recalculate Batch Qty"
msgstr "محاسبهٔ مجدد مقدار دسته"

#: erpnext/stock/doctype/batch/batch.json:None
msgid "Allow Negative Stock for Batch"
msgstr "اجازهٔ موجودی منفی برای دسته"

