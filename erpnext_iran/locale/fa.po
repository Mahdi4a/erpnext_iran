# Strings that had no translation

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.json:None
msgid "Credit Note will update it's own outstanding amount, even if 'Return Against' is specified."
msgstr "یادداشت بستانکاری مانده معوقهٔ خودش را به‌روزرسانی می‌کند، حتی اگر «برگشت از» تعیین شده باشد."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.json:None
msgid "Has Subcontracted"
msgstr "دارای پیمانکاری فرعی"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.json:None
msgid "If checked, updates inventory; stock and accounting entries are created together. Leave unchecked if a Delivery Note is created separately."
msgstr "در صورت علامت‌گذاری، موجودی انبار به‌روزرسانی می‌شود و ثبت‌های انبار و حسابداری هم‌زمان ایجاد می‌شوند. اگر یادداشت تحویل جداگانه ایجاد می‌شود، علامت نزنید."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.json:None
msgid "Is Rate Adjustment Entry (Debit Note)"
msgstr "ثبت اصلاح نرخ است (یادداشت بدهکاری)"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.json:None
msgid "Is created using POS"
msgstr "با POS ایجاد شده است"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.json:None
msgid "Issue a debit note against an existing Sales Invoice to adjust the rate. The quantity will be retained from the original invoice."
msgstr "برای اصلاح نرخ، یک یادداشت بدهکاری روی فاکتور فروش موجود صادر کنید. مقدار از فاکتور اصلی حفظ می‌شود."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1293
msgid "All items must be linked to a Sales Order or Subcontracting Inward Order for this Sales Invoice."
msgstr "همهٔ کالاهای این فاکتور فروش باید به یک سفارش فروش یا سفارش ورودی پیمانکاری فرعی مرتبط باشند."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1304
msgid "All linked Sales Orders must be subcontracted."
msgstr "همهٔ سفارش‌های فروش مرتبط باید پیمانکاری فرعی باشند."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:2853
msgid "Cannot create Intercompany {0}. All items in the source {1} have already been fully invoiced. Please check the existing linked {2}s."
msgstr "ایجاد {0} بین‌شرکتی ممکن نیست. همهٔ کالاهای {1} مبدأ قبلاً به‌طور کامل فاکتور شده‌اند. {2}‌های مرتبط موجود را بررسی کنید."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:365
msgid "Direct return is not allowed for Timesheet."
msgstr "برگشت مستقیم برای جدول زمانی مجاز نیست."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:2871
msgid "Invalid doctype {0}"
msgstr "نوع سند {0} نامعتبر است"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1248
msgid "Multiple POS Opening Entry"
msgstr "چند ثبت افتتاحیه POS"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1242
msgid "No open POS Opening Entry found for POS Profile {0}."
msgstr "ثبت افتتاحیه باز POS برای نمایهٔ POS {0} پیدا نشد."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1255
msgid "Outdated POS Opening Entry"
msgstr "ثبت افتتاحیه POS منقضی"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1256
msgid "POS Opening Entry - {0} is outdated. Please close the POS and create a new POS Opening Entry."
msgstr "ثبت افتتاحیه POS - {0} منقضی شده است. POS را ببندید و ثبت افتتاحیه جدیدی ایجاد کنید."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1241
msgid "POS Opening Entry Missing"
msgstr "ثبت افتتاحیه POS وجود ندارد"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1249
msgid "POS Profile - {0} has multiple open POS Opening Entries. Please close or cancel the existing entries before proceeding."
msgstr "نمایهٔ POS - {0} چند ثبت افتتاحیه باز دارد. پیش از ادامه، ثبت‌های موجود را ببندید یا لغو کنید."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1209
msgid "POS Profile is mandatory to mark this invoice as POS Transaction."
msgstr "برای علامت‌گذاری این فاکتور به‌عنوان تراکنش POS، نمایهٔ POS الزامی است."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1228
msgid "Partial Payment in POS Transactions are not allowed."
msgstr "پرداخت جزئی در تراکنش‌های POS مجاز نیست."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:3124
msgid "Payment methods refreshed. Please review before proceeding."
msgstr "روش‌های پرداخت تازه‌سازی شدند. پیش از ادامه آن‌ها را بررسی کنید."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1936
msgid "Please set Account for Change Amount"
msgstr "لطفاً حساب مبلغ باقیمانده (Change) را تعیین کنید"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1579
msgid "Return invoice of asset cancelled"
msgstr "فاکتور برگشتی دارایی لغو شد"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:446
msgid "Row #{0}: Return Against is required for returning asset"
msgstr "ردیف #{0}: برای برگشت دارایی، «برگشت از» الزامی است"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1322
msgid "Row #{0}: Stock quantity {1} ({2}) for item {3} cannot exceed {4}"
msgstr "ردیف #{0}: مقدار موجودی {1} ({2}) برای کالای {3} نمی‌تواند از {4} بیشتر باشد"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:940
msgid "Row {0}: Sales Invoice {1} is already created for {2}"
msgstr "ردیف {0}: فاکتور فروش {1} قبلاً برای {2} ایجاد شده است"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:407
msgid "Row {0}: Update Stock must be checked for item {1} because it is against Pick List {2}."
msgstr "ردیف {0}: «به‌روزرسانی موجودی» برای کالای {1} باید علامت‌گذاری شود، زیرا مربوط به لیست انتخاب {2} است."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1465
msgid "Sell quantity cannot exceed the asset quantity. Asset {0} has only {1} item(s)."
msgstr "مقدار فروش نمی‌تواند از مقدار دارایی بیشتر باشد. دارایی {0} فقط {1} مورد دارد."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1349
msgid "Stock cannot be updated because the invoice contains a drop shipping item. Please disable 'Update Stock' or remove the drop shipping item."
msgstr "موجودی قابل به‌روزرسانی نیست، زیرا فاکتور شامل کالای ارسال مستقیم (Drop Shipping) است. «به‌روزرسانی موجودی» را غیرفعال کنید یا کالای ارسال مستقیم را حذف کنید."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1556
msgid "This schedule was created when Asset {0} was restored due to Sales Invoice {1} cancellation."
msgstr "این زمان‌بندی هنگام بازیابی دارایی {0} به‌دلیل لغو فاکتور فروش {1} ایجاد شد."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1528
msgid "This schedule was created when Asset {0} was {1} through Sales Invoice {2}."
msgstr "این زمان‌بندی هنگامی ایجاد شد که دارایی {0} از طریق فاکتور فروش {2} {1} شد."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:949
msgid "Timesheet {0} cannot be invoiced in its current state"
msgstr "جدول زمانی {0} در وضعیت فعلی قابل فاکتور شدن نیست"

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:1213
msgid "Transactions using Sales Invoice in POS are disabled."
msgstr "تراکنش‌ها با فاکتور فروش در POS غیرفعال است."

#: erpnext/accounts/doctype/sales_invoice/sales_invoice.py:2883
msgid "{0} is not a valid reference field for {1}"
msgstr "{0} فیلد ارجاع معتبری برای {1} نیست"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.json:None
msgid "Claimed Landed Cost Amount (Company Currency)"
msgstr "مبلغ بهای تمام‌شدهٔ مطالبه‌شده (ارز شرکت)"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.json:None
msgid "Debit Note will update it's own outstanding amount, even if 'Return Against' is specified."
msgstr "یادداشت بدهکاری مانده معوقهٔ خودش را به‌روزرسانی می‌کند، حتی اگر «برگشت از» تعیین شده باشد."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.json:None
msgid "If checked, updates inventory; stock and accounting entries are created together. Leave unchecked if a Purchase Receipt is created separately."
msgstr "در صورت علامت‌گذاری، موجودی انبار به‌روزرسانی می‌شود و ثبت‌های انبار و حسابداری هم‌زمان ایجاد می‌شوند. اگر رسید خرید جداگانه ایجاد می‌شود، علامت نزنید."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.json:None
msgid "Totals (Company Currency)"
msgstr "جمع‌ها (ارز شرکت)"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.json:None
msgid "Update Billed Amount in Purchase Order"
msgstr "به‌روزرسانی مبلغ فاکتورشده در سفارش خرید"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.json:None
msgid "Update Billed Amount in Purchase Receipt"
msgstr "به‌روزرسانی مبلغ فاکتورشده در رسید خرید"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.json:None
msgid "Update Outstanding for Self"
msgstr "به‌روزرسانی مانده معوقه برای خود"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:357
msgid "Exchange rate {0} does not match the exchange rate of Purchase Receipt {1}. Use the same exchange rate as the Purchase Receipt or enable {2} in {3} to adjust the landed cost based on this invoice."
msgstr "نرخ تبدیل {0} با نرخ تبدیل رسید خرید {1} مطابقت ندارد. از همان نرخ تبدیل رسید خرید استفاده کنید یا برای تعدیل بهای تمام‌شده بر اساس این فاکتور، {2} را در {3} فعال کنید."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:1985
msgid "Invoice is not blocked. Block the invoice to change the release date."
msgstr "فاکتور مسدود نشده است. برای تغییر تاریخ آزادسازی، فاکتور را مسدود کنید."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:1776
msgid "Opening Invoice has rounding adjustment of {0}.<br><br> '{1}' account is required to post these values. Please set it in Company: {2}.<br><br> Or, '{3}' can be enabled to not post any rounding adjustment."
msgstr "فاکتور افتتاحیه تعدیل گرد کردن {0} دارد.<br><br> برای ثبت این مقادیر، حساب «{1}» لازم است. آن را در شرکت {2} تعیین کنید.<br><br> یا «{3}» را فعال کنید تا هیچ تعدیل گردکردنی ثبت نشود."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:440
msgid "Please ensure that the {0} account {1} is a Payable account. You can change the account type to Payable or select a different account."
msgstr "لطفاً مطمئن شوید حساب {0} یعنی {1} از نوع پرداختنی است. می‌توانید نوع حساب را به پرداختنی تغییر دهید یا حساب دیگری انتخاب کنید."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:721
msgid "Please enter a valid Write Off Account"
msgstr "لطفاً یک حساب حذف مانده (Write Off) معتبر وارد کنید"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:732
msgid "Please enter a valid Write Off Cost Center"
msgstr "لطفاً یک مرکز هزینهٔ حذف مانده (Write Off) معتبر وارد کنید"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:372
msgid "Purchase Invoice can be held after submitting."
msgstr "فاکتور خرید را پس از ثبت می‌توان نگه داشت."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:1995
msgid "Purchase Invoice without any outstanding amount cannot be held."
msgstr "فاکتور خرید بدون مانده معوقه را نمی‌توان نگه داشت."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:369
msgid "Return Purchase Invoice cannot be held."
msgstr "فاکتور خرید برگشتی را نمی‌توان نگه داشت."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:809
msgid "Stock Update Not Allowed"
msgstr "به‌روزرسانی موجودی مجاز نیست"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:806
msgid "Stock cannot be updated for Purchase Invoice {0} because a Purchase Receipt {1} has already been created for this transaction. Please disable the 'Update Stock' checkbox in the Purchase Invoice and save the invoice."
msgstr "موجودی برای فاکتور خرید {0} قابل به‌روزرسانی نیست، زیرا برای این تراکنش قبلاً رسید خرید {1} ایجاد شده است. گزینهٔ «به‌روزرسانی موجودی» را در فاکتور خرید غیرفعال کرده و فاکتور را ذخیره کنید."

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:1663
msgid "TDS Deducted"
msgstr "مالیات کسرشده از منبع (TDS)"

#: erpnext/accounts/doctype/purchase_invoice/purchase_invoice.py:392
msgid "dated {0}"
msgstr "مورخ {0}"

#: erpnext/accounts/doctype/payment_entry/payment_entry.js:1862
msgid "Cannot delete Exchange Gain/Loss row"
msgstr "ردیف سود/زیان تسعیر ارز قابل حذف نیست"

#: erpnext/accounts/doctype/payment_entry/payment_entry.js:1762
msgid "This Payment Entry is reconciled with {0}. Cancelling will automatically unreconcile it. Do you want to proceed?"
msgstr "این ثبت پرداخت با {0} تطبیق داده شده است. با لغو، تطبیق به‌طور خودکار برداشته می‌شود. ادامه می‌دهید؟"

#: erpnext/accounts/doctype/payment_entry/payment_entry.js:1731
msgid "Unset Matched Payment Request"
msgstr "برداشتن درخواست پرداخت منطبق"

#: erpnext/accounts/doctype/payment_entry/payment_entry.json:None
msgid "Reconcile on Advance Payment Date"
msgstr "تطبیق بر اساس تاریخ پرداخت پیش‌پرداخت"

#: erpnext/accounts/doctype/payment_entry/payment_entry.py:1287
msgid "Amount {0} {1} adjusted against {2} {3}"
msgstr "مبلغ {0} {1} در برابر {2} {3} تعدیل شد"

#: erpnext/accounts/doctype/payment_entry/payment_entry.py:1298
msgid "Amount {0} {1} as adjustment to {2}"
msgstr "مبلغ {0} {1} به‌عنوان تعدیل برای {2}"

#: erpnext/accounts/doctype/payment_entry/payment_entry.py:1971
msgid "Cannot {0} from {1} without any negative outstanding invoice"
msgstr "بدون فاکتور معوقهٔ منفی، {0} از {1} ممکن نیست"

#: erpnext/accounts/doctype/payment_entry/payment_entry.py:411
msgid "Invalid Allocated Amount"
msgstr "مبلغ تخصیص‌یافتهٔ نامعتبر"

#: erpnext/accounts/doctype/payment_entry/payment_entry.py:1176
msgid "Missing Default in Company"
msgstr "پیش‌فرض در شرکت تعریف نشده است"

#: erpnext/accounts/doctype/payment_entry/payment_entry.py:637
msgid "Paid From and Paid To accounts must be different for an Internal Transfer."
msgstr "در انتقال داخلی، حساب‌های پرداخت از و پرداخت به باید متفاوت باشند."

#: erpnext/accounts/doctype/payment_entry/payment_entry.py:408
msgid "Row #{0}: Allocated Amount cannot be greater than Outstanding Amount of Payment Request {1}"
msgstr "ردیف #{0}: مبلغ تخصیص‌یافته نمی‌تواند از مانده معوقهٔ درخواست پرداخت {1} بیشتر باشد"

#: erpnext/accounts/doctype/journal_entry/journal_entry.json:None
msgid "Custom Remark"
msgstr "توضیح سفارشی"

#: erpnext/accounts/doctype/journal_entry/journal_entry.json:None
msgid "For All Stock Asset Accounts"
msgstr "برای همهٔ حساب‌های دارایی موجودی"

#: erpnext/accounts/doctype/journal_entry/journal_entry.json:None
msgid "Make Difference Entry"
msgstr "ایجاد ثبت تفاوت"

#: erpnext/accounts/doctype/journal_entry/journal_entry.json:None
msgid "Party Not Required"
msgstr "طرف حساب لازم نیست"

#: erpnext/accounts/doctype/journal_entry/journal_entry.json:None
msgid "Periodic Entry Difference Account"
msgstr "حساب تفاوت ثبت دوره‌ای"

#: erpnext/accounts/doctype/journal_entry/journal_entry.py:367
msgid "Account {0} should be of type Expense"
msgstr "حساب {0} باید از نوع هزینه باشد"

#: erpnext/accounts/doctype/journal_entry/journal_entry.py:593
msgid "Cannot cancel this document as it is linked with the submitted Asset Value Adjustment <b>{0}</b>. Please cancel the Asset Value Adjustment to continue."
msgstr "این سند قابل لغو نیست، زیرا به تعدیل ارزش دارایی ثبت‌شدهٔ <b>{0}</b> مرتبط است. برای ادامه، تعدیل ارزش دارایی را لغو کنید."

#: erpnext/accounts/doctype/journal_entry/journal_entry.py:1594
msgid "Invalid filter"
msgstr "فیلتر نامعتبر"

#: erpnext/accounts/doctype/journal_entry/journal_entry.py:186
msgid "Making Journal Entries against advance accounts: {0} is not recommended. These Journals won't be available for Reconciliation."
msgstr "ثبت در دفتر روزنامه در برابر حساب‌های پیش‌پرداخت: {0} توصیه نمی‌شود. این اسناد در تطبیق در دسترس نخواهند بود."

#: erpnext/accounts/doctype/journal_entry/journal_entry.py:265
msgid "Periodic Accounting Entry is not allowed for company {0} with perpetual inventory enabled"
msgstr "ثبت حسابداری دوره‌ای برای شرکت {0} که موجودی دائمی دارد مجاز نیست"

#: erpnext/accounts/doctype/journal_entry/journal_entry.py:271
msgid "Please select Periodic Accounting Entry Difference Account"
msgstr "لطفاً حساب تفاوت ثبت حسابداری دوره‌ای را انتخاب کنید"

#: erpnext/accounts/doctype/journal_entry/journal_entry.py:1821
msgid "{0} is already a Reverse Journal Entry of {1}. Cancel it instead of reversing it."
msgstr "{0} از قبل ثبت معکوس {1} است. به‌جای معکوس کردن، آن را لغو کنید."

#: erpnext/accounts/doctype/journal_entry/journal_entry_list.js:6
msgid "Reversal Of Exchange Rate Revaluation"
msgstr "معکوس تجدید ارزیابی نرخ تبدیل"

#: erpnext/accounts/doctype/payment_request/payment_request.js:114
msgid "Cannot fetch selected rows for submitted Payment Request"
msgstr "ردیف‌های انتخاب‌شده برای درخواست پرداخت ثبت‌شده قابل دریافت نیستند"

#: erpnext/accounts/doctype/payment_request/payment_request.js:57
msgid "Email couldn't be sent."
msgstr "ایمیل ارسال نشد."

#: erpnext/accounts/doctype/payment_request/payment_request.json:None
msgid "<pre><h5>Message Example</h5>\n\n&lt;p&gt;Dear {{ doc.contact_person }},&lt;/p&gt;\n\n&lt;p&gt;Requesting payment for {{ doc.doctype }}, {{ doc.name }} for {{ doc.grand_total }}.&lt;/p&gt;\n\n&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n\n</pre>\n"
msgstr "<pre><h5>نمونهٔ پیام</h5>\n\n&lt;p&gt;{{ doc.contact_person }} عزیز،&lt;/p&gt;\n\n&lt;p&gt;درخواست پرداخت برای {{ doc.doctype }}، {{ doc.name }} به مبلغ {{ doc.grand_total }}.&lt;/p&gt;\n\n&lt;a href=\"{{ payment_url }}\"&gt; برای پرداخت اینجا کلیک کنید &lt;/a&gt;\n\n</pre>\n"

#: erpnext/accounts/doctype/payment_request/payment_request.py:134
msgid "Duplicate Payment Schedule selected"
msgstr "زمان‌بندی پرداخت تکراری انتخاب شده است"

#: erpnext/accounts/doctype/payment_request/payment_request.py:126
msgid "Grand Total must match sum of Payment References"
msgstr "جمع کل باید با مجموع مراجع پرداخت برابر باشد"

#: erpnext/accounts/doctype/payment_request/payment_request.py:587
msgid "Invalid parameter. 'dn' should be of type str"
